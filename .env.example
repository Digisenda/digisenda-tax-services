# Google Search Console verification code (Fase 1 / S1) — OPTIONAL, not currently
# needed: digisendaai.com is registered as a Domain property in Search Console
# (DNS-verified at the root domain), which automatically covers this subdomain.
# Only fill this in if tax.digisendaai.com is ever split into its own separate
# URL-prefix property (not recommended — see digisenda-tax-admin/docs/CONTINUITY.md).
NEXT_PUBLIC_GSC_VERIFICATION=

# Lead intake — where this site forwards leads from the "Agendar" form.
# Must match the digisenda-tax-admin deployment and its LEAD_INTAKE_TOKEN.
LEAD_INTAKE_URL=https://admin.tax.digisendaai.com/api/leads
LEAD_INTAKE_TOKEN=
